{
  "_meta": {
    "description": "LLM model assignments optimized for the Anthropic Claude 4.x ecosystem.",
    "last_updated": "2026-03-28",
    "constant_fields": ["_meta", "cost_rates"],
    "modify_fields": ["task_models", "agent_defaults", "fallback_chain"],
    "changelog": [
      "2026-03-28: Standardized on Sonnet 4-6. Removed all 3.7 variants. Replaced all Llama/Gemini references with Haiku 4.5 and 3.5."
    ]
  },

  "task_models": {
    "heavy": {
      "description": "Complex reasoning, drafting — High-end intelligence",
      "provider": "anthropic",
      "model": "anthropic/claude-sonnet-4-6",
      "max_tokens": 32768,
      "temperature": 0.3,
      "timeout_seconds": 180,
      "supports_prompt_caching": true
    },
    "budget_heavy": {
      "description": "High intelligence at lower cost — Haiku 4.5",
      "provider": "anthropic",
      "model": "anthropic/claude-haiku-4-5-20251001",
      "max_tokens": 16384,
      "temperature": 0.3,
      "timeout_seconds": 120,
      "supports_prompt_caching": true
    },
    "fast": {
      "description": "Tool-heavy tasks & classification — Haiku 4.5",
      "provider": "anthropic",
      "model": "anthropic/claude-haiku-4-5-20251001",
      "max_tokens": 8192,
      "temperature": 0.1,
      "timeout_seconds": 60
    },
    "mini": {
      "description": "Lightweight verification & extraction — Haiku 3.5",
      "provider": "anthropic",
      "model": "anthropic/claude-haiku-4-5-20251001",
      "max_tokens": 4096,
      "temperature": 0.1,
      "timeout_seconds": 60
    },
    "balanced": {
      "description": "Mid-tier quality + speed — Haiku 4.5",
      "provider": "anthropic",
      "model": "anthropic/claude-haiku-4-5-20251001",
      "max_tokens": 8192,
      "temperature": 0.2,
      "timeout_seconds": 90
    },
    "reasoning": {
      "description": "Strategic Analysis — Sonnet 4-6",
      "provider": "anthropic",
      "model": "anthropic/claude-sonnet-4-6",
      "max_tokens": 8192,
      "temperature": 0.2,
      "timeout_seconds": 120
    }
  },

  "agent_defaults": {
    "research_agent":      { "tier": "fast" },
    "reasoning_agent":     { "tier": "heavy" },
    "drafting_agent":      { "tier": "heavy" },
    "humanizer_agent":     { "tier": "balanced" },
    "verification_agent":  { "tier": "mini" },
    "execution_agent":     { "tier": "mini" },
    "memory_agent":        { "tier": "balanced" },
    "orchestrator":        { "tier": "balanced" },
    "consensus_agent":     { "tier": "heavy" },
    "hyde_rag":            { "tier": "mini" },
    "map_reduce_summarizer":{ "tier": "mini" },
    "discovery_tool_selector":{ "tier": "mini" },
    "auto_eval_analyzer":  { "tier": "heavy" }
  },

  "fallback_chain": {
    "_comment": "Order: Anthropic -> Google Gemini -> Groq -> OpenRouter",
    "heavy":        ["anthropic/claude-sonnet-4-6", "gemini/gemini-2.5-pro", "groq/openai/gpt-oss-120b", "openrouter/openai/gpt-4o"],
    "budget_heavy": ["anthropic/claude-haiku-4-5-20251001", "gemini/gemini-2.5-flash", "groq/openai/gpt-oss-20b", "openrouter/openai/gpt-4o-mini"],
    "fast":         ["anthropic/claude-haiku-4-5-20251001", "gemini/gemini-2.5-flash", "groq/openai/gpt-oss-20b", "openrouter/openai/gpt-4o-mini"],
    "balanced":     ["anthropic/claude-haiku-4-5-20251001", "gemini/gemini-2.5-flash", "groq/openai/gpt-oss-20b", "openrouter/openai/gpt-4o-mini"],
