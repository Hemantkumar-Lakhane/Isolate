{
  "_meta": {
    "workflow_id": "persona_builder",
    "name": "Persona Builder",
    "industry": "growth",
    "version": "1.0.0",
    "description": "Build and maintain approved brand/executive voice and persona context from approved source material.",
    "trigger_types": ["manual"],
    "trigger": {"type": "manual", "enabled": true},
    "sla_hours": 2,
    "estimated_duration_minutes": 2
  },
  "nodes": [
    {"id": "fetch_data","agent": "research_agent","name": "Gather Source Material","description": "Retrieve approved brand/voice sources.","prompt_file": "generic/prompt.txt","tools": [],"timeout_seconds": 60},
    {"id": "process_data","agent": "summarizer_agent","name": "Synthesize Persona","description": "Create persona description from sources.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["fetch_data"],"timeout_seconds": 120},
    {"id": "generate_output","agent": "drafting_agent","name": "Persist Persona","description": "Store persona definition for downstream use.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["process_data"],"timeout_seconds": 90},
    {"id": "persist_results","agent": "memory_agent","name": "Persist Persona Outcome","description": "Save persona record.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["generate_output"],"timeout_seconds": 30}
  ],
  "edges": [{"from": "fetch_data","to": "process_data"},{"from": "process_data","to": "generate_output"},{"from": "generate_output","to": "persist_results"}],
  "escalation_config": {"sla_hours": 2, "resume_after_decision": true}
}
