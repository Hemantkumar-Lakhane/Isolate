{
  "_meta": {
    "workflow_id": "patient_intake_triage",
    "name": "Patient Intake & Triage",
    "industry": "medical_tourism",
    "version": "1.0.0",
    "description": "Classify inquiry, identify missing information, safety flag, intake checklist and human coordinator review (no clinical diagnosis).",
    "trigger_types": ["manual"],
    "trigger": {"type": "manual", "enabled": true},
    "sla_hours": 2,
    "estimated_duration_minutes": 2
  },
  "nodes": [
    {"id": "fetch_data","agent": "research_agent","name": "Gather Inquiry","description": "Retrieve patient inquiry details.","prompt_file": "generic/prompt.txt","tools": [],"timeout_seconds": 60},
    {"id": "process_data","agent": "summarizer_agent","name": "Classify & Flag","description": "Classify inquiry, detect missing info and safety flags.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["fetch_data"],"timeout_seconds": 120},
    {"id": "generate_output","agent": "drafting_agent","name": "Create Intake Checklist","description": "Prepare coordinator checklist draft.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["process_data"],"timeout_seconds": 90},
    {"id": "persist_results","agent": "memory_agent","name": "Persist Intake Record",
      "description": "Store intake classification and checklist.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["generate_output"],"timeout_seconds": 30}
  ],
  "edges": [{"from": "fetch_data","to": "process_data"},{"from": "process_data","to": "generate_output"},{"from": "generate_output","to": "persist_results"}],
  "escalation_config": {"sla_hours": 2, "resume_after_decision": true}
}
