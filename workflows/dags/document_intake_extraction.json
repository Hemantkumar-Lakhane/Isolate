{
  "_meta": {
    "workflow_id": "document_intake_extraction",
    "name": "Document Intake & Extraction",
    "industry": "medical_tourism",
    "version": "1.0.0",
    "description": "Upload document, classify, OCR if needed, structured extraction with confidence, source citations, human review (non‑authoritative until approved).",
    "trigger_types": ["manual"],
    "trigger": {"type": "manual", "enabled": true},
    "sla_hours": 2,
    "estimated_duration_minutes": 2
  },
  "nodes": [
    {"id": "fetch_data","agent": "research_agent","name": "Retrieve Document","description": "Load uploaded document.","prompt_file": "generic/prompt.txt","tools": [],"timeout_seconds": 60},
    {"id": "process_data","agent": "summarizer_agent","name": "Classify & OCR","description": "Determine document type and perform OCR if needed.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["fetch_data"],"timeout_seconds": 120},
    {"id": "generate_output","agent": "drafting_agent","name": "Extract Structured Data","description": "Extract fields with confidence and citations.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["process_data"],"timeout_seconds": 90},
    {"id": "persist_results","agent": "memory_agent","name": "Persist Extraction",
      "description": "Store extracted data for reviewer.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["generate_output"],"timeout_seconds": 30}
  ],
  "edges": [{"from": "fetch_data","to": "process_data"},{"from": "process_data","to": "generate_output"},{"from": "generate_output","to": "persist_results"}],
  "escalation_config": {"sla_hours": 2, "resume_after_decision": true}
}
