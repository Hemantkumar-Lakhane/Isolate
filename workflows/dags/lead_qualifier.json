{
  "_meta": {
    "workflow_id": "lead_qualifier",
    "name": "Lead Qualifier",
    "industry": "growth",
    "version": "1.0.0",
    "description": "Process inbound leads, score/explain qualification, detect duplicates, route to owner and prepare approved follow-up.",
    "trigger_types": ["manual"],
    "trigger": {"type": "manual", "enabled": true},
    "sla_hours": 2,
    "estimated_duration_minutes": 2
  },
  "nodes": [
    {"id": "fetch_data","agent": "research_agent","name": "Fetch Leads","description": "Retrieve inbound lead records.","prompt_file": "generic/prompt.txt","tools": [],"timeout_seconds": 60},
    {"id": "process_data","agent": "summarizer_agent","name": "Score Leads","description": "Score and explain qualification.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["fetch_data"],"timeout_seconds": 120},
    {"id": "generate_output","agent": "drafting_agent","name": "Prepare Follow‑up","description": "Create follow‑up draft and routing.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["process_data"],"timeout_seconds": 90},
    {"id": "persist_results","agent": "memory_agent","name": "Persist Lead Decision",
      "description": "Store qualification result and assignment.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["generate_output"],"timeout_seconds": 30}
  ],
  "edges": [{"from": "fetch_data","to": "process_data"},{"from": "process_data","to": "generate_output"},{"from": "generate_output","to": "persist_results"}],
  "escalation_config": {"sla_hours": 2, "resume_after_decision": true}
}
