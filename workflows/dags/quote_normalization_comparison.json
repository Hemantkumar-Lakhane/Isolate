{
  "_meta": {
    "workflow_id": "quote_normalization_comparison",
    "name": "Quote Normalization & Comparison",
    "industry": "medical_tourism",
    "version": "1.0.0",
    "description": "Normalize provider quote into taxonomy, line items, inclusions/exclusions, assumptions, missing items, generate clarification questions (no provider ranking).",
