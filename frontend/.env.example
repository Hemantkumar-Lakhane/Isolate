# ═══════════════════════════════════════════════════════════════════════════════
# SMBFlow Frontend Environment Configuration Template
# Copy this file to `frontend/.env` (or `frontend/.env.local`).
# Note: Vite injects variables starting with `VITE_` into the frontend build.
# ═══════════════════════════════════════════════════════════════════════════════

# Base URL for the FastAPI backend HTTP API (must include /api/v1 prefix)
VITE_API_BASE=http://127.0.0.1:8000/api/v1

# Base URL for the FastAPI WebSocket endpoint
VITE_WS_BASE=ws://127.0.0.1:8000/ws

# Supabase Project URL (Obtained from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Obtained from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
