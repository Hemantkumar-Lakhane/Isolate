{
  "_meta": {
    "workflow_id": "coordinator_communication_copilot",
    "name": "Coordinator Communication Copilot",
    "industry": "medical_tourism",
    "version": "1.0.0",
    "description": "Generate editable patient/provider message drafts from approved case context and communication templates (draft‑only, never auto‑send).",
    "trigger_types": ["manual"],
    "trigger": {"type": "manual", "enabled": true},
    "sla_hours": 2,
    "estimated_duration_minutes": 2
  },
  "nodes": [
    {"id": "fetch_data","agent": "research_agent","name": "Load Case Context","description": "Retrieve approved case facts and template.","prompt_file": "generic/prompt.txt","tools": [],"timeout_seconds": 60},
    {"id": "process_data","agent": "summarizer_agent","name": "Draft Message","description": "Compose patient/provider message draft.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["fetch_data"],"timeout_seconds": 120},
    {"id": "generate_output","agent": "drafting_agent","name": "Review Draft","description": "Prepare draft for coordinator approval.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["process_data"],"timeout_seconds": 90},
    {"id": "persist_results","agent": "memory_agent","name": "Persist Communication Draft",
      "description": "Store draft and approval metadata.","prompt_file": "generic/prompt.txt","tools": [],"depends_on": ["generate_output"],"timeout_seconds": 30}
  ],
  "edges": [{"from": "fetch_data","to": "process_data"},{"from": "process_data","to": "generate_output"},{"from": "generate_output","to": "persist_results"}],
  "escalation_config": {"sla_hours": 2, "resume_after_decision": true}
}
