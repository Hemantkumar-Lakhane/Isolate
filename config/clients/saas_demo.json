  "action_library": {
    "send_csm_outreach_email": "Draft and queue a CSM check-in email referencing usage data",
    "send_executive_escalation": "Send VP-level email for critical accounts (requires human approval)",
    "create_hubspot_task": "Create an urgent task in HubSpot for the account owner",
    "post_slack_alert": "Post account risk alert to CS Slack channel",
    "schedule_call": "Book a customer success call via Google Calendar",
    "log_activity": "Log the intervention to CRM activity feed",
    "flag_for_renewal_team": "Alert the renewal team about account risk ahead of renewal date",
