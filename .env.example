# ═══════════════════════════════════════════════════════════════════════════════
# SMBFlow Backend Environment Configuration Template
# Copy this file to `.env` in the project root and fill in your actual values.
# NEVER commit `.env` containing live secrets to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Supabase PostgreSQL Database ──────────────────────────────────────────────
# Primary database connection string for Supabase PostgreSQL (pooled or direct).
# Format: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Supabase Authentication & Project Configuration ────────────────────────────
# Project URL & API Keys obtained from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# Supabase JWT Secret used by FastAPI backend (api/deps/auth.py) to decode and verify JWT bearer tokens.
# Obtained from Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Redis (Pub/Sub Relay & Semantic Cache) ────────────────────────────────────
# Redis connection URL for real-time WebSocket broadcasting and agent caching
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ─── Vault Encryption ─────────────────────────────────────────────────────────
# Master encryption key for MultiFernet credential vault (integrations/key_vault.py).
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=generate_a_valid_fernet_key_here

# ─── LLM Provider Credentials ──────────────────────────────────────────────────
# Add keys for the LLM providers enabled in your LiteLLM router configuration.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...
HUGGINGFACE_API_KEY=hf_...

# Optional LLM Model Overrides (see config/templates/llm_config.json)
LLM_HEAVY_MODEL=anthropic/claude-sonnet-4-20250514
LLM_FAST_MODEL=groq/llama-3.1-8b-instant
LLM_MINI_MODEL=anthropic/claude-haiku-4-5-20251001

# ─── RAG & Embeddings ──────────────────────────────────────────────────────────
PREFER_LOCAL_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ─── Application & Audit Log Settings ──────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
EPI_EVIDENCE_DIR=./evidence       # Directory for cryptographic audit traces (.epi)
EPI_AUTO_RECORD=true
ADMIN_REFRESH_RATE=2

# ═══════════════════════════════════════════════════════════════════════════════
# DEPRECATED / FALLBACK VARIABLES (Preserved for backwards compatibility)
# ═══════════════════════════════════════════════════════════════════════════════

# Legacy local JWT signing secret (Used ONLY as fallback in api/deps/auth.py if SUPABASE_JWT_SECRET is unset)
SECRET_KEY=change_this_to_a_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Legacy local postgres password (Obsolete when using Supabase pooled connection string above)
# POSTGRES_PASSWORD=opsgrid_dev_password

# Legacy seed admin user (Superseded by Supabase Auth; used only for optional local DB seed fallback in api/main.py)
# ADMIN_EMAIL=admin@smbflow.com
# ADMIN_PASSWORD=admin123
# ADMIN_FULL_NAME=SMBFlow Admin